---
import '../styles/global.css';
import {
  LANG,
  NAME,
  SITE_TITLE,
  SITE_DESCRIPTION,
  PROFILE_LINKS,
  WEBMENTION_ENDPOINT,
  BANNER,
} from '../site';

interface Props {
  /** The page title, without the site name. */
  title?: string;
  /** The meta description for this page. */
  description?: string;
  /**
   * Which look this page wears. `neon` is the site default. `paper` is the
   * typewriter look the blog uses: a cream sheet on a dark desk, struck in
   * Courier with a red ribbon for the links.
   */
  theme?: 'neon' | 'paper';
}

const { title, description = SITE_DESCRIPTION, theme = 'neon' } = Astro.props;

// The browser chrome follows the page. The desk behind the paper sheet is a
// shade lighter than the neon page, so the two do not read as the same black.
const themeColor = theme === 'paper' ? '#120d1c' : '#06040d';

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang={LANG} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Icons and the browser chrome colour, both from the PlatyByte
         artwork and the palette derived from it. -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} />

    <!-- The feed. Bridgy Fed discovers the site through this element. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} — blog`}
      href="/rss.xml"
    />

    <!-- rel="me" links, one for each profile. Server rendered, because a
         verifier does not run JavaScript. Mastodon reads these to verify
         the domain. Vernissage and BookWyrm do not verify, and the links
         are still what identifies the site to Bridgy Fed. -->
    {PROFILE_LINKS.map((link) => <link rel="me" href={link.href} />)}

    {
      WEBMENTION_ENDPOINT ? (
        <link rel="webmention" href={WEBMENTION_ENDPOINT} />
      ) : (
        <Fragment
          set:html={
            '<!-- TODO webmention: set WEBMENTION_ENDPOINT in src/site.ts to a ' +
            'webmention endpoint, for example the one webmention.io gives you. ' +
            'Until then this site sends no webmentions and receives none, so ' +
            'fediverse replies do not appear here. -->'
          }
        />
      )
    }

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(BANNER, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site-header">
        <nav aria-label="Main">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/rss.xml">Feed</a></li>
          </ul>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>{NAME} · {year} · <a href="/rss.xml">RSS</a></p>
      </footer>
    </div>
  </body>
</html>
