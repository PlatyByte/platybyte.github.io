---
import { LANG, SITE_TITLE } from '../site';

interface Props {
  /** Absolute URL to send the visitor to. */
  to: string;
  /** What sits at the other end, for the one line of fallback text. */
  label: string;
}

const { to, label } = Astro.props;
---

<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${label} — ${SITE_TITLE}`}</title>

    <!-- GitHub Pages serves files and cannot send a 301, so the redirect has
         to live in the page. This script runs before the browser paints, so
         nobody sees the page at all. `replace` keeps the short link out of
         the history, so Back goes where the visitor came from. -->
    <script is:inline data-to={to}>
      location.replace(document.currentScript.dataset.to);
    </script>

    <!-- The fallback, for a browser with no JavaScript. It is what actually
         makes the short link work, and the script above only hides it. -->
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        gap: 0.75rem;
        text-align: center;
        padding: 2rem;
        background: #06040d;
        color: #9d90c7;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.9rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      a {
        color: #22e7ff;
        text-underline-offset: 0.2em;
      }
      a:hover,
      a:focus-visible {
        color: #ff2d95;
      }
      :focus-visible {
        outline: 3px solid #ffcf3a;
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <p>Taking you to {label}</p>
    <p><a href={to}>Go there now</a></p>
  </body>
</html>
